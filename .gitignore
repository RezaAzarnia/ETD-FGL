# ----------------------------
results/
outputs/
runs/
logs/
wandb/

final_multidataset/
federated_cora/

# Generated experiment artifacts
training_history.csv
final_summary.json

# ----------------------------
# Model checkpoints
# ----------------------------
checkpoints/
best_model.pt
last_model.pt

# ----------------------------
