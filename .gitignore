*.py[cod]
*$py.class
*.pyd
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ----------------------------
# Virtual environments
# ----------------------------
.venv/
venv/
env/
ENV/

# ----------------------------
# IDE / Editor
# ----------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----------------------------
# Environment / secrets
# ----------------------------
.env
.env.*
!.env.example
*.key
*.pem

# ----------------------------
# Dataset files / caches
# ----------------------------
data/
cache/
datasets/

*.pt
*.pth
*.ckpt
*.bin

# ----------------------------
