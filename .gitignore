brain/
.task/
tasks/

# ----------------------------
# Generated plots / figures
# ----------------------------
# Do NOT globally ignore PNG/PDF because manuscript figures
# and documentation may intentionally be version-controlled.

# ----------------------------
# IMPORTANT: keep reproducibility files
# ----------------------------
!final_experiment_config.json
!requirements.txt
!README.md
!EXPERIMENT_NOTES.md
!EXTENDED_EXPERIMENTS.md

